@page "/notes"
@page "/notes/{NoteId:guid}"
@layout EmptyLayout
@inject NoteService NoteService
@using Paages.Domain.Interfaces
@inject ITabsState TabsState
@inject NavigationManager Navigation

<PageTitle>Заметки</PageTitle>

<div class="app-shell">
    <Sidebar ActiveNoteId="NoteId" />
    <TopBar />
    @if (_note is not null)
    {
        <NoteEditor @key="_note.Id" Note="_note" />
    }
    else
    {
        <div class="ne-empty">Выберите заметку слева</div>
    } 
</div>

@code {
    [Parameter] public Guid? NoteId { get; set; }

    private Note? _note;

    protected override async Task OnParametersSetAsync()
    {
        _note = NoteId.HasValue
            ? await NoteService.GetNoteAsync(NoteId.Value)
            : null;

        if (NoteId.HasValue)
            TabsState.Open(NoteId.Value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await TabsState.LoadFromCookiesAsync();
        if (NoteId is null && TabsState.ActiveTabId.HasValue)
            Navigation.NavigateTo($"/notes/{TabsState.ActiveTabId}");
    }
}