@page "/p/{Slug}"
@layout Paages.Web.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using Paages.Infrastructure.Services
@using Paages.Domain.Entities
@attribute [AllowAnonymous]
@inject PublicationService PublicationService

<PageTitle>@(Publication?.Title ?? "Заметка") - Paages</PageTitle>

@if (_isLoading)
{
    <div class="public-loading">Загрузка...</div>
}
else if (Publication is null)
{
    <div class="public-not-found">
        <h1>404</h1>
        <p>Заметка не найдена или была удалена.</p>
    </div>
}
else
{
    <div class="public-wrapper">
        <article class="public-article">
            <h1 class="public-title">@Publication.Title</h1>

            <div class="public-meta">
                автор @Publication.AuthorNickname • изменено @(Publication.UpdatedAt.ToLocalTime().ToString("d MMMM yyyy в HH:mm"))
            </div>

            <div class="public-content ql-editor">
                @((MarkupString)Publication.ContentHtml)
            </div>
        </article>
    </div>

    <script>
        // Syntax highlighting for code blocks in the published note. highlight.js
        // is loaded globally in App.razor. Blocks already containing hljs token
        // spans (saved from the editor) are left untouched. Detection runs once
        // per block; lines are highlighted individually.
        (function () {
            document.querySelectorAll('.public-content .ql-code-block-container').forEach(function (container) {
                if (container.querySelector('[class*="hljs"]')) return;
                const lines = container.querySelectorAll('.ql-code-block');
                if (!lines.length) return;

                // Prefer the language persisted by the editor (data-language,
                // e.g. 'cs' from '```csharp'); fall back to auto-detection.
                const stored = (container.getAttribute('data-language')
                    || (lines[0] && lines[0].getAttribute('data-language'))
                    || '').toLowerCase();
                const detected = hljs.highlightAuto(
                    Array.from(lines).map(function (l) { return l.textContent; }).join('\n')
                ).language;

                const lang = stored && stored !== 'plain' && stored !== 'true' && hljs.getLanguage(stored)
                    ? stored
                    : (detected && hljs.getLanguage(detected) ? detected : null);

                lines.forEach(function (line) {
                    line.innerHTML = lang
                        ? hljs.highlight(line.textContent, { language: lang }).value
                        : hljs.highlightAuto(line.textContent).value;
                });
            });
        })();
    </script>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private Publication? Publication;
    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        Publication = await PublicationService.GetBySlugAsync(Slug);
        _isLoading = false;
    }
}
