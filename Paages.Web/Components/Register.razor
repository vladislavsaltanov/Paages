@page "/register"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authorization
@using Paages.Domain.Exceptions
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject UserAccountService Accounts
@inject NavigationManager Navigation
@inject AccountTokenService Verification

<PageTitle>Регистрация</PageTitle>

<div class="auth-shell">
    <div class="auth-logo">Paages</div>

    <div class="auth-tabs">
        <a class="auth-tab" href="/login">вход</a>
        <span class="auth-tab auth-tab-active">регистрация</span>
    </div>

    @if (_sent)
    {
        <div class="auth-card"><p>Мы отправили письмо на @_model!.Email. Перейдите по ссылке, чтобы подтвердить почту.</p></div>
    }
    else
    {
        <EditForm Model="_model!" OnValidSubmit="HandleRegister" FormName="register" class="auth-form" id="register-form">
            <DataAnnotationsValidator />

            @if (_error is not null)
            {
                <p class="auth-error">@_error</p>
            }

            <div class="auth-fields">
                <div class="auth-field">
                    <label>введите свою почту</label>
                    <InputText @bind-Value="_model!.Email" placeholder="you@example.com" />
                </div>

                <div class="auth-field">
                    <label>введите пароль</label>
                    <InputText type="password" @bind-Value="_model!.Password" placeholder="••••••••" />
                </div>
            </div>

            <button type="submit" class="auth-submit" @onclick="ResetError">зарегистрироваться</button>

            <a href="/account/login-google" class="auth-google-btn">
                <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                Зарегистрироваться через Google
            </a>
        <AsciiLoader FormId="register-form"/>
        </EditForm>
        }
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel? _model { get; set; }
    protected override void OnInitialized() => _model ??= new LoginModel();

    private string? _error;
    private bool _sent;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task HandleRegister()
    {
        try
        {
            var user = await Accounts.RegisterUserAsync(_model!.Email, _model.Password);
            await Verification.IssueEmailConfirmationAsync(user, Navigation.BaseUri);
            _sent = true;
        }
        catch (EmailAlreadyRegisteredException)
        {
            _error = "Такая почта уже зарегистрирована!";
        }
    }
    private void ResetError() => _error = null;
    public class LoginModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required] public string Password { get; set; } = "";
    }
}