@inject AppState AppState
@using Paages.Domain.Interfaces
@inject ITabsState TabsState
@inject NoteService NoteService
@inject NavigationManager Navigation
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IUIController UIController


<header class="topbar">

    <div class="tb-row">

        <span class="tb-breadcrumbs">
        @for (int i = 0; i < _path.Count; i++)
        {
            var part = _path[i];
            if (i == _path.Count - 1)
            {
                <span class="tb-breadcrumbs current">@part</span>
            }
            else
            {
                <span class="tb-breadcrumbs">@part &gt;</span>
            }
        }
        </span>

        <div class="tb-actions">
            <form method="post" action="/account/logout" class="tb-logout-form">
                <AntiforgeryToken />
                <button type="submit" class="tb-icon tb-logout-btn">выйти</button>
            </form>
            <button class="tb-view-btn">просмотр</button>
            <span class="tb-saved">@(AppState.LastSavedAt?.ToString("сохранено в HH:mm") ?? "не сохранено")</span>
            <span class="tb-icon">
                <svg viewBox="0 0 14 11.5" width="14" height="12"><path fill="#fff" d="M13.8537 5.1466L8.8537 0.1466C8.7838 0.0767 8.6948 0.029 8.5978 0.0097 8.5008-0.0097 8.4002 0.0002 8.3089 0.038 8.2175 0.0758 8.1393 0.1398 8.0844 0.222 8.0294 0.3042 8 0.4009 8 0.4998V3.0216C6.3787 3.1604 4.5881 3.9541 3.115 5.2035 1.3412 6.7085 0.2368 8.6479 0.005 10.6641-0.0132 10.8209 0.0186 10.9794 0.0958 11.117 0.173 11.2547 0.2916 11.3645 0.4347 11.4308 0.5779 11.4971 0.7384 11.5166 0.8933 11.4865 1.0482 11.4563 1.1896 11.3781 1.2975 11.2629 1.985 10.531 4.4312 8.2166 8 8.0129V10.4998C8 10.5987 8.0294 10.6953 8.0844 10.7775 8.1393 10.8597 8.2175 10.9238 8.3089 10.9616 8.4002 10.9994 8.5008 11.0092 8.5978 10.9899 8.6948 10.9705 8.7838 10.9229 8.8537 10.8529L13.8537 5.8529C13.9472 5.7592 13.9997 5.6322 13.9997 5.4998 13.9997 5.3674 13.9472 5.2404 13.8537 5.1466ZM9 9.2929V7.4998C9 7.3672 8.9473 7.24 8.8535 7.1462 8.7597 7.0524 8.6326 6.9998 8.5 6.9998 6.745 6.9998 5.0356 7.4579 3.4193 8.3623 2.5962 8.8249 1.8292 9.3811 1.1337 10.0198 1.4962 8.5298 2.41 7.1129 3.7618 5.966 5.2131 4.7354 6.9843 3.9998 8.5 3.9998 8.6326 3.9998 8.7597 3.9471 8.8535 3.8533 8.9473 3.7596 9 3.6324 9 3.4998V1.7073L12.7931 5.4998 9 9.2929Z" /></svg>
            </span>
            <span class="tb-icon">
                <svg viewBox="0 0 10.5 2" width="16" height="16"><path fill="#fff" d="M6.25 1C6.25 1.1978 6.1914 1.3911 6.0815 1.5556 5.9716 1.72 5.8154 1.8482 5.6327 1.9239 5.45 1.9996 5.2489 2.0194 5.0549 1.9808 4.8609 1.9422 4.6827 1.847 4.5429 1.7071 4.403 1.5673 4.3078 1.3891 4.2692 1.1951 4.2306 1.0011 4.2504 0.8 4.3261 0.6173 4.4018 0.4346 4.53 0.2784 4.6944 0.1685 4.8589 0.0586 5.0522 0 5.25 0 5.5152 0 5.7696 0.1054 5.9571 0.2929 6.1446 0.4804 6.25 0.7348 6.25 1ZM1 0C0.8022 0 0.6089 0.0586 0.4444 0.1685 0.28 0.2784 0.1518 0.4346 0.0761 0.6173 0.0004 0.8-0.0194 1.0011 0.0192 1.1951 0.0578 1.3891 0.153 1.5673 0.2929 1.7071 0.4327 1.847 0.6109 1.9422 0.8049 1.9808 0.9989 2.0194 1.2 1.9996 1.3827 1.9239 1.5654 1.8482 1.7216 1.72 1.8315 1.5556 1.9414 1.3911 2 1.1978 2 1 2 0.7348 1.8946 0.4804 1.7071 0.2929 1.5196 0.1054 1.2652 0 1 0ZM9.5 0C9.3022 0 9.1089 0.0586 8.9444 0.1685 8.78 0.2784 8.6518 0.4346 8.5761 0.6173 8.5004 0.8 8.4806 1.0011 8.5192 1.1951 8.5578 1.3891 8.653 1.5673 8.7929 1.7071 8.9327 1.847 9.1109 1.9422 9.3049 1.9808 9.4989 2.0194 9.7 1.9996 9.8827 1.9239 10.0654 1.8482 10.2216 1.72 10.3315 1.5556 10.4414 1.3911 10.5 1.1978 10.5 1 10.5 0.7348 10.3946 0.4804 10.2071 0.2929 10.0196 0.1054 9.7652 0 9.5 0Z" /></svg>
            </span>
        </div>
    </div>

        <div class="tb-tabs-row" id="tb-tabs-row">
        <button class="tb-tabs-arrow tb-tabs-arrow-left" @onclick="() => Scroll(-150)">‹</button>

        <div class="tb-tabs" id="tb-tabs-scroll">
            @foreach (var id in TabsState.OpenTabsIds)
            {
                <div class="tb-tab @(id == TabsState.ActiveTabId ? "tb-tab-active" : "tb-tab-inactive")"
                    @onclick="() => _ = OpenTab(id)">
                    <span class="tb-tab-title">@(_titles.GetValueOrDefault(id, "..."))</span>
                    <span @onclick="() => CloseTab(id)" @onclick:stopPropagation="true">@CloseIcon</span>
                </div>
            }
        </div>

        <button class="tb-tabs-arrow tb-tabs-arrow-right" @onclick="() => Scroll(150)">›</button>
    </div>

</header>

@code {
    private Dictionary<Guid, string> _titles = new();
    private IJSObjectReference? _scrollModule;
    private bool _scrollInitialized;
    private static readonly MarkupString CloseIcon = new("""
        <svg viewBox="0 0 10 10" width="8" height="8" class="tab-close-icon"><path fill="rgba(255,255,255,0.6)" d="M9.854 9.1465C9.9005 9.193 9.9373 9.2481 9.9625 9.3088 9.9876 9.3695 10.0006 9.4346 10.0006 9.5003 10.0006 9.566 9.9876 9.631 9.9625 9.6917 9.9373 9.7524 9.9005 9.8076 9.854 9.854 9.8076 9.9005 9.7524 9.9373 9.6917 9.9625 9.631 9.9876 9.566 10.0006 9.5003 10.0006 9.4346 10.0006 9.3695 9.9876 9.3088 9.9625 9.2481 9.9373 9.193 9.9005 9.1465 9.854L5.0003 5.7072 0.854 9.854C0.7602 9.9478 0.633 10.0006 0.5003 10.0006 0.3676 10.0006 0.2403 9.9478 0.1465 9.854 0.0527 9.7602 0 9.633 0 9.5003 0 9.3676 0.0527 9.2403 0.1465 9.1465L4.2934 5.0003 0.1465 0.854C0.0527 0.7602 0 0.633 0 0.5003 0 0.3676 0.0527 0.2403 0.1465 0.1465 0.2403 0.0527 0.3676 0 0.5003 0 0.633 0 0.7602 0.0527 0.854 0.1465L5.0003 4.2934 9.1465 0.1465C9.2403 0.0527 9.3676 0 9.5003 0 9.633 0 9.7602 0.0527 9.854 0.1465 9.9478 0.2403 10.0006 0.3676 10.0006 0.5003 10.0006 0.633 9.9478 0.7602 9.854 0.854L5.7072 5.0003 9.854 9.1465Z" /></svg>
        """);


    private List<string> _path = new();

    private async Task<List<string>> PathToNote(Guid? guid)
    {
        if (guid is null) return new List<string>();
        var result = new List<string>();

        var note = await NoteService.GetNoteAsync(guid.Value);
        if (note is null) return result;
        
        result.Add(note.Title);

        if (!note.FolderId.HasValue) return result;

        var folder = await NoteService.GetFolderAsync(note.FolderId.Value);
        while (folder is not null)
        {
            result.Add(folder.Name);
            if (!folder.ParentId.HasValue) break;
            folder = await NoteService.GetFolderAsync(folder.ParentId.Value);
        }

        return result;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _scrollModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tabsScroll.js");
        
        if (_scrollModule is not null && !_scrollInitialized)
        {
            _scrollInitialized = true;
            await _scrollModule.InvokeVoidAsync("initTabsScroll", "tb-tabs-scroll", "tb-tabs-row");
        }

        var newPath = (await PathToNote(TabsState.ActiveTabId)).AsEnumerable().Reverse().ToList();
        if (!newPath.SequenceEqual(_path))
        {
            _path = newPath;
            StateHasChanged();
        }
    }

    private async Task Scroll(int delta)
    {
        if (_scrollModule is null) return;
        
        await _scrollModule.InvokeVoidAsync("scrollByAmount", "tb-tabs-scroll", delta);
    }

    protected override async Task OnInitializedAsync()
    {
        TabsState.OnTabsChanged += OnTabsChanged;
        AppState.OnChange += StateHasChanged;
        AppState.NoteRenamed += OnNoteRenamed;
        AppState.OnTreeChanged += OnTreeChanged;
        await RefreshTitlesAsync();
    }

    private void OnTreeChanged() => _ = RefreshPathAsync();
    private void OnTabsChanged() => _ = RefreshTitlesAsync();

    private async Task RefreshPathAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing tree: {ex.Message}");
            // TODO: log
        }
    }

    private void OnNoteRenamed(Guid noteId, string newTitle)
    {
        if (!_titles.ContainsKey(noteId)) return;
        _titles[noteId] = newTitle;
        InvokeAsync(StateHasChanged);
    }
    private async Task RefreshTitlesAsync()
    {
        var notes = await NoteService.GetNotesByIdsAsync(TabsState.OpenTabsIds);
        _titles = notes.ToDictionary(n => n.Id, n => n.Title);
        await InvokeAsync(StateHasChanged);

        if (_scrollModule is not null)
            await _scrollModule.InvokeVoidAsync("refreshScrollState", "tb-tabs-scroll");
    }

    private async Task OpenTab(Guid noteId)
    {
        Navigation.NavigateTo($"/notes/{noteId}");

        if (await NoteService.HasFolder(noteId))
            UIController.InvokeFolderExpansion(await NoteService.GetAllDescendantFolderIdsAsync(noteId));
    }
    private void CloseTab(Guid id)
    {
        var next = TabsState.Close(id);
        Navigation.NavigateTo(next.HasValue ? $"/notes/{next}" : "/notes");
    }

    public async ValueTask DisposeAsync()
    {
        AppState.OnChange -= StateHasChanged;
        TabsState.OnTabsChanged -= OnTabsChanged;
        AppState.NoteRenamed -= OnNoteRenamed;
        AppState.OnTreeChanged -= OnTreeChanged;
        if (_scrollModule is not null)
            try
            {
                await _scrollModule.InvokeVoidAsync("destroyTabsScroll", "tb-tabs-scroll");
                await _scrollModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
    }
}
