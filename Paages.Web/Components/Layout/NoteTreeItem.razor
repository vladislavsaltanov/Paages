@using Paages.Web.Services
@using Paages.Domain.Interfaces
@implements IDisposable
@inject NavigationManager Navigation
@inject DragDropState DragDropState
@using Paages.Domain.Entities
@inject ContextMenuState ContextMenuState
@inject ITabsState TabsState
@inject ConfirmDialogState ConfirmDialogState
@inject IJSRuntime JS

<div class="sb-tree-row @(Note.Id == ActiveNoteId ? "sb-tree-active" : "") @(DragDropState.DraggedNodeId == Note.Id || ForceDisabled ? "sb-tree-dragging" : "")"
     draggable="true"
     @ondragstart="() => DragDropState.StartDrag(Note.Id, false)"
     @ondragend="DragDropState.EndDrag"
     @onclick="() => OpenNote(Note.Id)"
     id="@($"tree-row-{Note!.Id}")"
     @ondragover:preventDefault="true"
     @ondrop="HandleDrop"
     @oncontextmenu="OpenContextMenu" @oncontextmenu:preventDefault="true"
     @oncontextmenu:stopPropagation="true"
     data-is-folder="false">
    <div class="sb-tree-row-content" style="padding-left: @(PaddingLeft)px">
        <span class="chevron-wrapper"></span>
            @if (_isRenaming)
            {
                <input class="sb-tree-rename-input"
                    id="@($"rename-input-{Note!.Id}")"
                    @bind="_renameValue"
                    @bind:event="oninput"
                    @onclick:stopPropagation="true"
                    @onblur="SubmitRename"
                    @onkeydown="HandleRenameKeydown" />
            }
            else
            {
                <span class="sb-tree-label">@Note.Title</span>
            }
    </div>
</div> 
 
@code {
    [Inject] private AppState AppState { get; set; } = null!;
    [Inject] private NoteService NoteService { get; set; } = null!;
    [Parameter] public Guid? NextSiblingId { get; set; }
    [Parameter] public bool ForceDisabled { get; set; } = false;
    [Parameter, EditorRequired] public Note Note { get; set; } = null!;
    [Parameter] public int PaddingLeft { get; set; } = 16;
    [Parameter] public Guid? ActiveNoteId { get; set; }

    private bool _isRenaming, _wasRenaming;
    private string _renameValue = "";

    private void StartRename()
    {
        _renameValue = Note!.Title;
        _isRenaming = true;
    }

    private async Task SubmitRename(FocusEventArgs e)
    {
        if (!_isRenaming) return;

        _isRenaming = false;
        await NoteService.RenameNoteAsync(Note!.Id, _renameValue);
    }

    private async Task HandleRenameKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _isRenaming = false;
            await NoteService.RenameNoteAsync(Note!.Id, _renameValue);
        }
        else if (e.Key == "Escape")
        {
            _isRenaming = false;
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isRenaming && !_wasRenaming)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/treeRename.js");
            await module.InvokeVoidAsync("focusAndSelect", $"rename-input-{Note!.Id}");
        }
        _wasRenaming = _isRenaming;
    }

    protected override void OnInitialized()
    {
        DragDropState.Changed += StateHasChanged;
        AppState.NoteRenamed += OnNoteRenamed;
    }
    void OpenNote(Guid noteId)
    {
        Navigation.NavigateTo($"/notes/{noteId}");
    }
    public void Dispose()
    {
        DragDropState.Changed -= StateHasChanged;
        AppState.NoteRenamed -= OnNoteRenamed;
    }
    private async Task HandleDrop(DragEventArgs e)
    {
        if (DragDropState.DraggedNodeId is not Guid draggedId) return;
        
        double y = await DragDropState.GetRelativeYAsync($"tree-row-{Note.Id}", e.ClientY);
        var insertBefore = y < 0.5 ? Note.Id : NextSiblingId;

        await NoteService.MoveAsync(draggedId, DragDropState.DraggedIsFolder, Note.FolderId, insertBefore);
        await DragDropState.ClearIndicatorAsync();

        DragDropState.EndDrag();
    }
    private void OnNoteRenamed(Guid noteId, string newTitle)
    {
        if (noteId != Note.Id) return;
        Note.Title = newTitle;
        InvokeAsync(StateHasChanged);
    }

    private List<ContextMenuEntry> BuildMenu() => new()
    {
        new ContextMenuItem("Открыть", () => { OpenNote(Note.Id); return Task.CompletedTask; }),
        new ContextMenuItem("Открыть в новой вкладке", () => { TabsState.OpenBackground(Note.Id); return Task.CompletedTask; }),
        new ContextMenuSeparator(),
        new ContextMenuItem(Note.IsPinned ? "Открепить" : "Закрепить", () => NoteService.TogglePinAsync(Note.Id, false)),
        new ContextMenuItem("Переименовать", () => { StartRename(); return Task.CompletedTask; }), // TODO: focus title input via JS
        new ContextMenuItem("Дублировать", () => { return NoteService.DuplicateNoteAsync(Note.Id); }),
        new ContextMenuSeparator(),
        new ContextMenuItem("Скачать", () => Task.CompletedTask),
        new ContextMenuItem("Поделиться", () => Task.CompletedTask),
        new ContextMenuSeparator(),
        new ContextMenuItem("Удалить", () =>
        {
            ConfirmDialogState.Open($"Удалить заметку «{Note.Title}»?", () => NoteService.DeleteNoteAsync(Note.Id));
            return Task.CompletedTask;
        }, Destructive: true)
};

    private void OpenContextMenu(MouseEventArgs e)
    {
        ContextMenuState.Open(e.ClientX, e.ClientY, BuildMenu());
    }
}