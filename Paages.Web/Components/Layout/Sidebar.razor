@code {
    [Inject] private IJSRuntime JS { get; set; } = null!;
    private IJSObjectReference? _dragDropModule;
    [Inject] private NoteService NoteService { get; set; } = null!;
    [Parameter] public Guid? ActiveNoteId { get; set; }

    private List<ITreeNode> _pinnedItems = new();
    
    private static readonly MarkupString FolderIcon = new("""
        <svg viewBox="0 0 12 12" width="12" height="12" class="folder-icon"><path fill="#ffdb89" d="M3.5 4C3.5 3.8674 3.5527 3.7402 3.6464 3.6464 3.7402 3.5527 3.8674 3.5 4 3.5H8C8.1326 3.5 8.2598 3.5527 8.3536 3.6464 8.4473 3.7402 8.5 3.8674 8.5 4 8.5 4.1326 8.4473 4.2598 8.3536 4.3536 8.2598 4.4473 8.1326 4.5 8 4.5H4C3.8674 4.5 3.7402 4.4473 3.6464 4.3536 3.5527 4.2598 3.5 4.1326 3.5 4ZM4 6.5H8C8.1326 6.5 8.2598 6.4473 8.3536 6.3536 8.4473 6.2598 8.5 6.1326 8.5 6 8.5 5.8674 8.4473 5.7402 8.3536 5.6464 8.2598 5.5527 8.1326 5.5 8 5.5H4C3.8674 5.5 3.7402 5.5527 3.6464 5.6464 3.5527 5.7402 3.5 5.8674 3.5 6 3.5 6.1326 3.5527 6.2598 3.6464 6.3536 3.7402 6.4473 3.8674 6.5 4 6.5ZM6 7.5H4C3.8674 7.5 3.7402 7.5527 3.6464 7.6464 3.5527 7.7402 3.5 7.8674 3.5 8 3.5 8.1326 3.5527 8.2598 3.6464 8.3536 3.7402 8.4473 3.8674 8.5 4 8.5H6C6.1326 8.5 6.2598 8.4473 6.3536 8.3536 6.4473 8.2598 6.5 8.1326 6.5 8 6.5 7.8674 6.4473 7.7402 6.3536 7.6464 6.2598 7.5527 6.1326 7.5 6 7.5ZM12 1V7.7931C12.0004 7.9245 11.9747 8.0546 11.9244 8.176 11.8741 8.2973 11.8001 8.4075 11.7069 8.5L8.5 11.7069C8.4075 11.8001 8.2973 11.8741 8.176 11.9244 8.0546 11.9747 7.9245 12.0004 7.7931 12H1C0.7348 12 0.4804 11.8946 0.2929 11.7071 0.1054 11.5196 0 11.2652 0 11V1C0 0.7348 0.1054 0.4804 0.2929 0.2929 0.4804 0.1054 0.7348 0 1 0H11C11.2652 0 11.5196 0.1054 11.7071 0.2929 11.8946 0.4804 12 0.7348 12 1ZM1 11H7.5V8C7.5 7.8674 7.5527 7.7402 7.6464 7.6464 7.7402 7.5527 7.8674 7.5 8 7.5H11V1H1V11ZM8.5 8.5V10.2937L10.2931 8.5H8.5Z" /></svg>
        """);

    List<Folder> _folderTree = new();
    List<Note> _notesWithoutFolder = new();

    private IEnumerable<ITreeNode> RootItems =>
        _folderTree.Cast<ITreeNode>().Concat(_notesWithoutFolder).OrderBy(item => item.SortOrder);

    protected override void OnInitialized()
    {
        AppState.OnTreeChanged += OnTreeChanged;
    }

    private void OnTreeChanged() => _ = RefreshTreeAsync();

    private async Task RefreshTreeAsync()
    {
        try
        {
            _folderTree = await NoteService.GetFolderTreeAsync();
            _notesWithoutFolder = await NoteService.GetNotesWithoutFolderAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing tree: {ex.Message}");
            // TODO: log
        }
    }

    public void Dispose() => AppState.OnTreeChanged -= OnTreeChanged;

    protected override async Task OnInitializedAsync()
    {
        _folderTree = await NoteService.GetFolderTreeAsync();
        _notesWithoutFolder = await NoteService.GetNotesWithoutFolderAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dragDropModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dragDrop.js");
            await _dragDropModule.InvokeVoidAsync("initTreeDragOver", "sidebar-tree-root");
        }

        var pinnedFolders = await NoteService.GetPinnedItemsAsync();
        if (!pinnedFolders.SequenceEqual(_pinnedItems))
        {
            _pinnedItems = pinnedFolders;
            StateHasChanged();
        }
    }
    private void OpenNote(Guid noteId)
    {
        Navigation.NavigateTo($"/notes/{noteId}");
    }

    private async Task CreateNote()
    {
        var note = await NoteService.CreateNoteAsync(folderId: null);
        Navigation.NavigateTo($"/notes/{note.Id}");
    }
    private async Task HandleDrop(DragEventArgs e)
    {
        if (DragDropState.DraggedNodeId is not Guid draggedId) return;
        await NoteService.MoveAsync(draggedId, DragDropState.DraggedIsFolder, null, null);
        await DragDropState.ClearIndicatorAsync();
        DragDropState.EndDrag();
    }

    private void OpenRootContextMenu(MouseEventArgs e)
    {
        var entries = new List<ContextMenuEntry>
        {
            new ContextMenuItem("Новая заметка", async () =>
            {
                var note = await NoteService.CreateNoteAsync(folderId: null);
                Navigation.NavigateTo($"/notes/{note.Id}");
            }),
            new ContextMenuItem("Новая папка", () => NoteService.CreateFolderAsync(parentId: null))
        };

        ContextMenuState.Open(e.ClientX, e.ClientY, entries);
    }
}
