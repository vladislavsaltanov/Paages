@* Quill-backed note editor. #note-content-area is the mount point for Quill. *@
@using Microsoft.JSInterop
@inject NoteService NoteService
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppState AppState

<section class="note-editor">
    <div class="ne-inner">

        <h1 class="ne-title" id="@TitleElementId" contenteditable="true">@Note?.Title</h1>

        <div class="ne-meta">
            создано @Note?.CreatedAt.ToLocalTime().ToString("d MMMM yyyy") • изменено @Note?.UpdatedAt.ToLocalTime().ToString("d MMMM yyyy в HH:mm")
        </div>

        <div id="@ElementId" class="ne-body"></div>
        
        <div class="ne-save-status @(_showSavedStatus ? "visible" : "")">
                    сохранено @_lastSavedAt.ToString("HH:mm")
        </div>
    </div>
</section> 


@code {
    private readonly string TitleElementId = $"note-title-{Guid.NewGuid():N}";
    private readonly string ElementId = $"note-content-area-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<NoteEditor>? _dotNetRef;
    private CancellationTokenSource? _hideStatusCts;

    [Parameter]
    public Note? Note { get; set; }

    private DateTime _lastSavedAt;
    private bool _showSavedStatus;

    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        if (Note is not null)
            AppState.SetLastSaved(Note.UpdatedAt.ToLocalTime());

        AppState.NoteRenamed += OnNoteRenamedExternally;
    }

    private async void OnNoteRenamedExternally(Guid noteId, string newTitle)
    {
        Console.WriteLine($"[DEBUG] OnNoteRenamedExternally called: noteId={noteId}, Note?.Id={Note?.Id}, newTitle={newTitle}, module={_module is not null}");
        
        if (Note is null || noteId != Note.Id) return;
        if (Note.Title == newTitle) return;

        Note.Title = newTitle;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("setTitleText", TitleElementId, newTitle);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/noteEditor.js");
            if (_disposed) return;

            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("createEditor", ElementId, Note?.ContentHtml, _dotNetRef);
            await _module.InvokeVoidAsync("bindTitleEditing", ElementId, TitleElementId, _dotNetRef);
        }
        catch (JSDisconnectedException)
        {
            // circuit already gone - nothing to recover
        }
        catch (JSException)
        {
            // container vanished mid-flight (rapid note switching) - editor just won't mount for this instance
        }
        catch (Exception ex)
        {
            Console.WriteLine("Unknown error was thrown. " + ex?.Message);
        }
    }

    public async Task<string> GetHtmlAsync()
    {
        if (_module is null) return string.Empty;
        return await _module.InvokeAsync<string>("getHtml", ElementId);
    }

    [JSInvokable]
    public async Task OnContentChanged(string html)
    {
        if (Note is null) return;

        await NoteService.SaveNoteContentAsync(Note.Id, html);

        _lastSavedAt = DateTime.Now;
        AppState.SetLastSaved(DateTime.Now);
        _showSavedStatus = true;
        StateHasChanged();

        _hideStatusCts?.Cancel();
        _hideStatusCts = new CancellationTokenSource();
        var token = _hideStatusCts.Token;
        try
        {
            await Task.Delay(2000, token);
            _showSavedStatus = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Ignore cancellation
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _hideStatusCts?.Cancel();
        AppState.NoteRenamed -= OnNoteRenamedExternally;

        if (_module is null) return;

        try
        {
            await _module.InvokeVoidAsync("destroyEditor", ElementId);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (e.g. tab closed) — nothing to clean up.
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }

    [JSInvokable]
    public async Task OnTitleChanged(string title)
    {
        if (Note is null) return;
        Note.Title = await NoteService.RenameNoteAsync(Note.Id, title);
    }
}