@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject UserAccountService Accounts
@inject AccountTokenService Tokens
@inject NavigationManager Navigation

<PageTitle>Восстановление пароля</PageTitle>

<div class="auth-shell">
    <div class="auth-logo">Paages</div>

    @if (_sent)
    {
        <div class="auth-card">
            <p>Если такой email зарегистрирован - на него отправлено письмо со ссылкой для сброса пароля.</p>
        </div>
    }
    else
    {
        <EditForm Model="_model!" OnValidSubmit="HandleSubmit" FormName="forgot-password" class="auth-card">
            <DataAnnotationsValidator />
            <div class="auth-field">
                <label>введите свою почту</label>
                <InputText @bind-Value="_model!.Email" placeholder="you@example.com" />
            </div>
            <button type="submit" class="auth-submit">отправить ссылку</button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private FormModel? _model { get; set; }
    protected override void OnInitialized() => _model ??= new FormModel();

    private bool _sent;

    private async Task HandleSubmit()
    {
        var user = await Accounts.FindByEmailAsync(_model!.Email);
        if (user is not null)
            await Tokens.IssuePasswordResetAsync(user, Navigation.BaseUri);

        _sent = true;
    }

    public class FormModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
    }
}
